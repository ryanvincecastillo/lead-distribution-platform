NODE_ENV=development
PORT=4400
# Bind address. Use 127.0.0.1 in production so the API is not publicly reachable.
HOST=0.0.0.0

DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000
COOKIE_NAME=ldp_session
# Set to true only when serving over HTTPS.
COOKIE_SECURE=false
# Number of proxy hops in front of the API, used to resolve the real client IP.
TRUST_PROXY=1

LOG_LEVEL=info

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
PUBLIC_LEAD_RATE_LIMIT_MAX=20

# Used by `npm run db:seed` to create the admin account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
